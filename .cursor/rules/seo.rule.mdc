});
```

#### Property Listings
```typescript
export const metadata: Metadata = generateSeoMetadata({
  title: `${property.address} | ${property.bedrooms}BR/${property.bathrooms}BA | $${property.price.toLocaleString()} | Cape Coral`,
  description: `${property.bedrooms} bedroom, ${property.bathrooms} bathroom ${property.type.toLowerCase()} in ${property.neighborhood}, Cape Coral. ${property.features?.slice(0, 3).join(", ")}. Contact Sun Gulf Realty today.`,
